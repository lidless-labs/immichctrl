{
  "_comment": "content-guard: allow email file",
  "name": "immich-mcp",
  "version": "0.5.0",
  "description": "Operator control CLI for Immich with an MCP adapter for photo search, curation, memories, duplicates, stacks, and safe agent workflows",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "immich-mcp": "dist/mcp-bin.js",
    "immichctrl": "dist/cli.js",
    "immichctl": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/cli.js mcp",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "npm run build && IMMICH_INTEGRATION=true vitest run tests/integration",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm test && npm run build"
  },
  "author": "Solomon Neas <me@solomonneas.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lidless-labs/immichctrl.git"
  },
  "homepage": "https://github.com/lidless-labs/immichctrl#readme",
  "bugs": {
    "url": "https://github.com/lidless-labs/immichctrl/issues"
  },
  "keywords": [
    "mcp",
    "cli",
    "immichctrl",
    "immich",
    "photos",
    "model-context-protocol",
    "llm-tools",
    "claude",
    "home-media"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@immich/sdk": "^2.7.5",
    "@lidless-labs/effect-operator-kit": "github:lidless-labs/effect-operator-kit",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^7.0.2",
    "vitest": "^2.0.0"
  }
}
